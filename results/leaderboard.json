    {
      "name": "NimSumBot",
      "icon": "\ud83e\udd77",
      "authors": [
        "tu nombre"
      ],
      "description": "It would always win if possible using XOR rule."
    },
    {
      "name": "XorMaster",
      "icon": "\ud83e\uddee",
      "authors": [
        "Antonio Orteu",
        "mariasanzm"
      ],
      "description": "Plays the nim-sum strategy: always moves to a position whose XOR is zero. When already losing, it stalls by taking one stick from the largest row to give the opponent more chances to err."
    },
    {
      "name": "easy",
      "icon": "\ud83c\udf31",
      "authors": [
        "builtin"
      ],
      "description": "Always empties the largest row. A plausible-looking rule that is barely better than random: taking as much as possible just hands the opponent a simpler position."
    },
    {
      "name": "hard",
      "icon": "\u2694\ufe0f",
      "authors": [
        "builtin"
      ],
      "description": "Minimax with alpha-beta pruning, searching 4 plies. Recognises several endgames outright \u2014 a single row, all-ones boards by parity, mirrored rows, and a few tabulated positions \u2014 and steers play toward the endgames it knows. Strong, but it cannot see every losing position."
    },
    {
      "name": "medium",
      "icon": "\ud83e\udde0",
      "authors": [
        "builtin"
      ],
      "description": "Minimax with alpha-beta pruning, searching 2 plies and then guessing from the number of sticks left. Solid right at the end of a game, unreliable before that."
    },
    {
      "name": "random",
      "icon": "\ud83c\udfb2",
      "authors": [
        "builtin"
      ],
      "description": "Picks uniformly at random among all legal moves. No strategy at all \u2014 the baseline every other player has to beat."
    }
